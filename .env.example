# Local settings for this machine (see .env.example for every option).

# Where jobs are kept. Shared by the web UI and convert.py, so both see the
# same job list. C: has the most free space on this machine.
WPSC_JOBS_DIR=C:\wpsc-jobs

# Extra folders the UI searches for .wpress backups (separate several with ;).
# Downloads, Desktop and Documents are always searched as well.
WPSC_BACKUP_DIRS=C:\bkp
